{
  "clockify": {
    "apiKey": "YOUR_CLOCKIFY_API_KEY",
    "workspaceId": "YOUR_WORKSPACE_ID"
  },
  "jira": {
    "baseUrl": "https://your-domain.atlassian.net",
    "email": "your-email@example.com",
    "apiToken": "YOUR_JIRA_API_TOKEN"
  },
  "webhook": {
    "enabled": false,
    "port": 3100,
    "secret": "YOUR_WEBHOOK_SECRET"
  },
  "polling": {
    "enabled": true,
    "intervalMinutes": 5
  },
  "sync": {
    "lookbackWindow": "24h",
    "blacklist": {
      "jiraKeys": [],
      "clockifyProjectIds": [],
      "clockifyTaskIds": []
    }
  },
  "database": {
    "path": "./data/wsync.db"
  }
}
